# 统一换行符，避免 Windows 提交把整份文件标记为改动
* text=auto

*.py    text eol=lf
*.pyi   text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.toml  text eol=lf
*.txt   text eol=lf
*.cfg   text eol=lf
*.svg   text eol=lf
*.sh    text eol=lf

# 二进制资源
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.zip   binary

# 版本库中的生成物不参与语言统计
docs/badges/coverage.svg  linguist-generated=true
